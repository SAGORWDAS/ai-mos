# Copy to .env.validation in the project root; never commit the filled file.
# Use scripts/prepare-validation.py to generate private random secrets instead.
APP_ENV=validation
VALIDATION_DOMAIN=pilot.example.com
PUBLIC_API_URL=https://pilot.example.com/api
ALLOWED_ORIGINS=["https://pilot.example.com"]
SECURE_COOKIES=true
PUBLIC_INDEXING_ENABLED=false
ALLOW_UNVERIFIED_MODELS=false
PROVIDER_MODE=sandbox
WORKER_ENABLED=false
TOKEN_ENCRYPTION_KEY=replace-with-generated-Fernet-key
VALIDATION_ACCESS_CODE=replace-with-private-random-pilot-code
VALIDATION_REVIEW_REF=replace-with-operator-review-reference
POSTGRES_PASSWORD=replace-with-random-URL-safe-migrator-password
APP_DATABASE_PASSWORD=replace-with-random-URL-safe-API-password
WORKER_DATABASE_PASSWORD=replace-with-random-URL-safe-worker-password
MODEL_MAX_COST_MICROS=20000
MODEL_CACHE_SECONDS=21600
PAYMENT_WEBHOOK_SECRET=replace-with-random-sandbox-webhook-secret
