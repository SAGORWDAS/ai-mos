{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/outreach_draft.json",
  "title": "OutreachDraft",
  "description": "Output of AGT-07. Each factual assertion must cite a brand chunk; uncited claims fail validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "body", "word_count", "personalisation", "claims", "cta", "confidence"],
  "properties": {
    "subject": { "type": "string", "minLength": 3, "maxLength": 90 },
    "body": { "type": "string", "minLength": 40, "maxLength": 1200 },
    "word_count": { "type": "integer", "minimum": 30, "maximum": 140 },
    "personalisation": {
      "type": "array",
      "description": "Each item must be traceable to a retrieved fact about this prospect.",
      "items": {
        "type": "object",
        "required": ["text", "evidence_ref"],
        "properties": {
          "text": { "type": "string" },
          "evidence_ref": { "type": "string", "description": "lead field, research artifact id or source URL" }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Product or business assertions. Empty array is acceptable; an uncited claim is not.",
      "items": {
        "type": "object",
        "required": ["text", "brand_chunk_id"],
        "properties": {
          "text": { "type": "string" },
          "brand_chunk_id": { "type": "string", "format": "uuid" }
        }
      }
    },
    "cta": { "type": "string", "enum": ["meeting_request", "question", "resource_share", "no_cta"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
  }
}
