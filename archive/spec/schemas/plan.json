{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/plan.json",
  "title": "ExecutionPlan",
  "description": "Output of AGT-01 for a confirmed objective. Persisted to plans, tasks and task_dependencies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective", "business_goal", "target_audience", "execution_plan",
               "assigned_agents", "tasks", "dependencies", "estimated_cost_usd",
               "required_approvals", "success_metrics", "risks", "final_status"],
  "properties": {
    "objective": { "type": "string", "minLength": 8, "maxLength": 500 },
    "business_goal": { "type": "string", "enum": ["leads", "sales", "cac", "retention", "efficiency"] },
    "target_audience": {
      "type": "object",
      "required": ["segment", "size_estimate", "geo"],
      "properties": {
        "segment": { "type": "string" },
        "size_estimate": { "type": "integer", "minimum": 0 },
        "geo": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "signals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "execution_plan": { "type": "string", "description": "Human-readable summary, max 200 words." },
    "assigned_agents": {
      "type": "array",
      "items": { "type": "string", "pattern": "^AGT-[0-9]{2}$" },
      "minItems": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_id", "type", "agent_id", "description", "estimated_cost_usd"],
        "properties": {
          "local_id": { "type": "string", "pattern": "^t[0-9]+$" },
          "type": { "type": "string" },
          "agent_id": { "type": "string", "pattern": "^AGT-[0-9]{2}$" },
          "description": { "type": "string" },
          "estimated_cost_usd": { "type": "number", "minimum": 0 },
          "requires_approval": { "type": "boolean", "default": false },
          "success_metric": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "string", "pattern": "^t[0-9]+$" },
        "minItems": 2,
        "maxItems": 2
      },
      "description": "Pairs [task, depends_on]. Must be acyclic."
    },
    "estimated_cost_usd": { "type": "number", "minimum": 0 },
    "required_approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action_class", "reason"],
        "properties": {
          "action_class": { "type": "string" },
          "reason": { "type": "string" },
          "approver_role": { "type": "string", "enum": ["owner", "admin", "member"] }
        }
      }
    },
    "success_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "target", "window_days"],
        "properties": {
          "metric": { "type": "string", "enum": ["qualified_leads", "reply_rate", "meetings", "customers", "cpl", "cac"] },
          "target": { "type": "number" },
          "window_days": { "type": "integer", "minimum": 1 }
        }
      },
      "minItems": 1
    },
    "missing_information": {
      "type": "array",
      "items": { "type": "string" },
      "description": "If non-empty the plan is NOT executable and must be returned to the user."
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk", "mitigation"],
        "properties": { "risk": { "type": "string" }, "mitigation": { "type": "string" } }
      }
    },
    "final_status": { "type": "string", "enum": ["ready", "needs_information", "blocked"] }
  }
}
