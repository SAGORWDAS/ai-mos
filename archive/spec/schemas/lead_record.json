{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/lead_record.json",
  "title": "LeadRecord",
  "description": "Normalised lead written by TLS-05. Source and confidence are mandatory; verification is a separate event.",
  "type": "object",
  "additionalProperties": false,
  "required": ["company", "contact", "source", "source_confidence", "status"],
  "properties": {
    "company": {
      "type": "object",
      "required": ["domain"],
      "properties": {
        "domain": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
        "name": { "type": "string" },
        "industry": { "type": "string" },
        "employee_range": { "type": "string" },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "contact": {
      "type": "object",
      "required": ["full_name"],
      "properties": {
        "full_name": { "type": "string" },
        "title": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "email_verified": { "type": "boolean", "default": false },
        "linkedin_url": { "type": "string", "format": "uri" }
      }
    },
    "source": { "type": "string", "enum": ["provider", "inbound", "referral", "first_party", "public_web"] },
    "source_ref": { "type": "string", "description": "Provider record id or URL. Required for audit." },
    "source_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "lawful_basis": { "type": "string", "enum": ["consent", "legitimate_interest", "contract", "not_required"] },
    "status": {
      "type": "string",
      "enum": ["discovered", "enriched", "scored", "qualified", "disqualified", "suppressed"]
    },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "score_model": { "type": "string", "description": "Scoring configuration version that produced score." },
    "score_reasons": { "type": "array", "items": { "type": "string" } }
  }
}
