POSTGRES_USER=ai_mos
POSTGRES_PASSWORD=ai_mos
POSTGRES_DB=ai_mos

DATABASE_URL=postgresql+asyncpg://ai_mos:ai_mos@db:5432/ai_mos
REDIS_URL=redis://redis:6379/0

# Sandbox needs no provider secrets. Prefer encrypted per-workspace connections in the UI.
# TOKEN_ENCRYPTION_KEY is generated by the Windows launcher. For Compose generate a
# persistent Fernet key; losing it makes saved connection credentials unreadable.
OPENROUTER_API_KEY=
TOKEN_ENCRYPTION_KEY=

APP_ENV=development
SENTRY_DSN=
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://api:8000
PROVIDER_MODE=sandbox
MODEL_ID=
EMBEDDING_MODEL_ID=
IMAGE_MODEL_ID=
# Reuse validated identical requests for six hours. Set 0 to disable.
MODEL_CACHE_SECONDS=21600
# Change these when deploying behind a trusted HTTPS reverse proxy.
PUBLIC_API_URL=http://localhost:3000/api
# Enable only for approved public pages on your configured HTTPS domain.
PUBLIC_INDEXING_ENABLED=false
SECURE_COOKIES=false
WORKER_ENABLED=true
PAYMENT_WEBHOOK_SECRET=placeholder-local-test-secret-do-not-use-live

# Development database roles; use different strong values before deployment.
APP_DATABASE_PASSWORD=placeholder-app-local
WORKER_DATABASE_PASSWORD=placeholder-worker-local
